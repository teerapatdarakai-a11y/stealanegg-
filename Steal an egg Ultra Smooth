local function isRealSecretEgg(obj)
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    local n = string.lower(obj.Name)
    if not (string.find(n, "secret") or string.find(n, "divine") or string.find(n, "mythic") or string.find(n, "egg")) then return false end
    local root = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    if not root or root.Transparency >= 1 then return false end
    return true
end

local function GetClosestEgg()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart
    local closestEgg, shortestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isRealSecretEgg(obj) then
            local root = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if root then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < shortestDist then 
                    shortestDist = dist
                    closestEgg = obj 
                end
            end
        end
    end
    return closestEgg
end

local function SafeTeleport(targetCFrame)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    if currentTween then currentTween:Cancel() end
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local duration = dist / 150
    if duration < 0.05 then 
        hrp.CFrame = targetCFrame
        return 
    end
    currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()
    currentTween.Completed:Wait()
end

-- ==========================================
-- ฟังก์ชันลบแล็กขั้นสุด (POTATO MODE FUNCTION)
-- ==========================================
local function ApplyPotatoMode()
    pcall(function()
        -- 1. ลบ Texture, ลบแสงสี, ปรับทุกอย่างเป็น Smooth Plastic สีเทาด้าน
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and not v:IsDescendantOf(player.Character) then
                -- เช็คไม่ให้ไปลบตัวแปรสำคัญหรือตัวไข่
                if not isRealSecretEgg(v) and not isRealSecretEgg(v.Parent) then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Color = Color3.fromRGB(120, 120, 120) -- พื้นผิวสีเทา
                    v.CastShadow = false
                    if v:IsA("MeshPart") then 
                        v.TextureID = "" 
                    end
                end
            elseif v:IsA("Texture") or v:IsA("Decal") or v:IsA("ShirtGraphic") then
                v:Destroy()
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Fire") then
                v.Enabled = false
            end
        end

        -- 2. ย้อมสีตัวละครของผู้เล่นทุกคนรวมถึงเราให้เป็นสีเทาล้วน
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                for _, part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Color = Color3.fromRGB(80, 80, 80) -- ตัวละครสีเทาเข้มขึ้นมาหน่อย
                        part.Material = Enum.Material.SmoothPlastic
                    elseif part:IsA("Accessory") or part:IsA("Clothing") or part:IsA("CharacterMesh") or part:IsA("FaceControls") then
                        part:Destroy() -- ลบชุดและทรงผมทิ้งเพื่อลดความแล็ก
                    end
                end
            end
        end

        -- 3. ปิดเอฟเฟกต์ท้องฟ้าและเงาในเกม
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") or effect:IsA("Atmosphere") or effect:IsA("Sky") then
                effect:Destroy()
            end
        end
    end)
end

